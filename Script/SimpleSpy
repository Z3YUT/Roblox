function newRemote(type, data)
    if layoutOrderNum < 1 then layoutOrderNum = 999999999 end
    local remote = data.remote
    local RemoteTemplate = Create("Frame",{LayoutOrder = layoutOrderNum,Parent = LogList,BackgroundTransparency = 1,Size = UDim2.new(0, 117, 0, 27)})
    local ColorBar = Create("Frame",{Parent = RemoteTemplate,BackgroundColor3 = (type == "event" and Color3.fromRGB(255, 242, 0)) or Color3.fromRGB(99, 86, 245),BorderSizePixel = 0,Position = UDim2.new(0, 0, 0, 1),Size = UDim2.new(0, 7, 0, 18)})
    local Text = Create("TextLabel",{TextTruncate = Enum.TextTruncate.AtEnd,Parent = RemoteTemplate,BackgroundTransparency = 1,Position = UDim2.new(0, 12, 0, 1),Size = UDim2.new(0, 105, 0, 18),Font = Enum.Font.SourceSans,Text = remote.Name,TextColor3 = Color3.new(1, 1, 1),TextSize = 14,TextXAlignment = Enum.TextXAlignment.Left})
    local Button = Create("TextButton",{Parent = RemoteTemplate,BackgroundTransparency = 0.75,Position = UDim2.new(0, 0, 0, 1),Size = UDim2.new(0, 117, 0, 18),AutoButtonColor = false,Text = ""})

    local log = {
        Name = remote.Name,
        Remote = remote,
        args = data.args,
        Log = RemoteTemplate,
        Button = Button,
        GenScript = "-- Generating..."
    }

    logs[#logs + 1] = log
    local connect = Button.MouseButton1Click:Connect(function()
        eventSelect(RemoteTemplate)
        log.GenScript = genScript(log.Remote, log.args)
    end)
    layoutOrderNum -= 1
    table.insert(remoteLogs, 1, {connect, RemoteTemplate})
    clean()

    if SearchBox.Text ~= "" and not lower(remote.Name):find(lower(SearchBox.Text), 1, true) then
        RemoteTemplate.Visible = false
    end
    updateRemoteCanvas()
end

function genScript(remote, args)
    local gen = ""
    if #args > 0 then
        xpcall(function()
            gen = "local args = "..LazyFix.Convert(args, true) .. "\n"
        end,function(err)
            gen = "local args = {}\n"
        end)
        gen ..= LazyFix.ConvertKnown("Instance", remote) .. (remote:IsA("RemoteFunction") and ":InvokeServer(unpack(args))" or ":FireServer(unpack(args))")
    else
        gen ..= LazyFix.ConvertKnown("Instance", remote) .. (remote:IsA("RemoteFunction") and ":InvokeServer()" or ":FireServer()")
    end
    return gen
end

local function taskscheduler()
    if not toggle then scheduled = {} return end
    if #scheduled > 0 then
        local currentf = scheduled[1]
        table.remove(scheduled, 1)
        if type(currentf) == "table" then pcall(unpack(currentf)) end
    end
end

function schedule(f, ...) table.insert(scheduled, {f, ...}) end

local function remoteHandler(data)
    if data.remote:IsA("RemoteEvent") or data.remote:IsA("UnreliableRemoteEvent") or data.remote:IsA("RemoteFunction") then
        newRemote(data.remote:IsA("RemoteFunction") and "function" or "event", data)
    end
end

local newnamecall = newcclosure(function(...)
    local method = getnamecallmethod()
    if method and (method == "FireServer" or method == "InvokeServer") then
        local remote = cloneref(...)
        if typeof(remote) == "Instance" then
            schedule(remoteHandler, {method = method, remote = remote, args = deepclone({select(2,...)})})
        end
    end
    return originalnamecall(...)
end)

if not getgenv().SimpleSpyExecuted then
    getgenv().SimpleSpyShutdown = function()
        if schedulerconnect then schedulerconnect:Disconnect() end
        SimpleSpy3:Destroy()
        Storage:Destroy()
        getgenv().SimpleSpyExecuted = false
    end
    codebox = Highlight.new(CodeBox)
    if hookmetamethod then originalnamecall = hookmetamethod(game, "__namecall", clonefunction(newnamecall)) end
    schedulerconnect = RunService.Heartbeat:Connect(taskscheduler)
    SimpleSpy3.Parent = (gethui and gethui()) or CoreGui
    getgenv().SimpleSpyExecuted = true
end

-- ================= TOMBOL FITUR & EKSPOR =================
newButton("Copy Code", function() return "Click to copy code" end, function()
    setclipboard(codebox:getString())
    TextLabel.Text = "Copied successfully!"
end)

newButton("Run Code", function() return "Click to execute code" end, function()
    if selected and selected.Remote then
        xpcall(function()
            if selected.Remote:IsA("RemoteFunction") then
                selected.Remote:InvokeServer(unpack(selected.args))
            else
                selected.Remote:FireServer(unpack(selected.args))
            end
            TextLabel.Text = "Executed successfully!"
        end, function(err) TextLabel.Text = "Error: " .. err end)
    end
end)

newButton("Code To File", function() return "Export generated script to Workspace file" end, function()
    if selected and codebox and writefile then
        local fileName = string.format("Simple_Spy/Export_Output/%s_Code_%s.txt", selected.Name, os.date("%Y%m%d_%H%M%S"))
        writefile(fileName, codebox:getString())
        TextLabel.Text = "Saved to: " .. fileName
    end
end)

newButton("Dcmp To File", function() return "Export decompiled source to Workspace file" end, function()
    if selected and selected.Source and decompile and writefile then
        TextLabel.Text = "Decompiling & Saving..."
        spawn(function()
            local success, decompiled = pcall(decompile, selected.Source)
            local fileName = string.format("Simple_Spy/Export_Output/%s_Dcmp_%s.txt", selected.Name, os.date("%Y%m%d_%H%M%S"))
            writefile(fileName, success and decompiled or "-- Decompile failed")
            TextLabel.Text = "Saved to: " .. fileName
        end)
    end
end)

newButton("Auto-Scroll", function() return "Lock/Unlock auto log scrolling" end, function()
    realconfigs.autoscroll = not realconfigs.autoscroll
    TextLabel.Text = string.format("Auto-Scroll: %s", realconfigs.autoscroll and "ENABLED" or "DISABLED")
end)

newButton("Clr Logs", function() return "Click to clear logs" end, function()
    clear(logs)
    for _, v in next, LogList:GetChildren() do
        if not v:IsA("UIListLayout") then v:Destroy() end
    end
    codebox:setRaw("")
    selected = nil
    TextLabel.Text = "Logs cleared!"
end)
